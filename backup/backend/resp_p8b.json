":{"gpt-5.4-mini-2026-03-17":{"prompt":48298,"completion":407,"cached":36608,"calls":3}},"per_phase":{"classify":{"prompt":10390,"completion":159,"cached":10240,"calls":1},"tool_loop":{"prompt":37908,"completion":248,"cached":26368,"calls":2}}}},"page_action":{"action":"show_results","payload":{"cards":[{"node_id":"ac18e9bf-3209-4606-a598-e8e290c9b999","title":"Grundlagen der Bruchrechnung","description":"Bruchrechnung ist wie ein magisches Zauberspiel in der Welt der Mathematik. Mit Brüchen können wir Teile von Dingen in kleine Stücke schneiden und sie gerecht unter Freunden aufteilen. In diesem Abenteuer lernen wir, wie man Brüche liest, addiert und subtrahiert, um gemeinsam noch mehr Spaß zu haben!","disciplines":["Mathematik"],"educational_contexts":["Sekundarstufe I"],"user_roles":[],"keywords":["Zähler","Nenner","Bruchstrich","Teile","Zahlenstrahl","Vergleich","Brüche vergleichen"],"learning_resource_types":[],"url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/ac18e9bf-3209-4606-a598-e8e290c9b999","wlo_url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/ac18e9bf-3209-4606-a598-e8e290c9b999","download_url":"","content_url":"","preview_url":"https://repository.staging.openeduhub.net/edu-sharing/preview?nodeId=ac18e9bf-3209-4606-a598-e8e290c9b999&storeProtocol=workspace&storeId=SpacesStore&dontcache=1778794510396","preview_is_icon":false,"mime_type":"","file_size":0,"license":"","publisher":"","node_type":"collection","topic_pages":[],"guide_url":"","link":""},{"node_id":"d6c88b81-b639-4b89-94d7-c0507a3e90be","title":"Bruchrechnung","description":"Brüche finden in vielen privaten und beruflichen Bereichen Anwendung. Sie zeigen (Stimm-)Anteile und Mischungsverhältnisse. Breuchrechnung bildet die Grundlage zum Verständnis von Gleichungsberechnungen.","disciplines":["Mathematik"],"educational_contexts":["Sekundarstufe I"],"user_roles":[],"keywords":["Bruch","Brüche"],"learning_resource_types":[],"url":"https://re