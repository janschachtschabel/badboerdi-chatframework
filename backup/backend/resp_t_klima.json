aging.openeduhub.net/edu-sharing/preview?nodeId=a9f1accf-a35a-45eb-a10c-a1b387ea3f5d&storeProtocol=workspace&storeId=SpacesStore&dontcache=1778832915944","preview_is_icon":false,"mime_type":"","file_size":0,"license":"","publisher":"","node_type":"collection","topic_pages":[],"guide_url":"","link":""},{"node_id":"0f98878d-4bf8-4ed5-933b-c0ad0d36263e","title":"Chemie und Umwelt","description":"Chemie ist allgegenwärtig: Biologische Prozesse basieren ebenso auf chemischen Reaktionen wie Körperpflegeprodukte, Reinigungsmittel und industrielle Produktionsprozesse. Mit anderen Worten: Chemie ist überall in der Umwelt. Gleichzeitig bergen die Prozesse der chemischen Industrie vielfältige Gefahren für die Umwelt.","disciplines":["Chemie"],"educational_contexts":["Sekundarstufe I","Sekundarstufe II"],"user_roles":[],"keywords":["Umweltchemie","Chemie und Umwelt","Umwelt","Umweltschutz","Umweltzerstörung","Klimawandel","Biochemie"],"learning_resource_types":[],"url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/0f98878d-4bf8-4ed5-933b-c0ad0d36263e","wlo_url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/0f98878d-4bf8-4ed5-933b-c0ad0d36263e","download_url":"","content_url":"","preview_url":"https://repository.staging.openeduhub.net/edu-sharing/preview?nodeId=0f98878d-4bf8-4ed5-933b-c0ad0d36263e&storeProtocol=workspace&storeId=SpacesStore&dontcache=1778832915964","preview_is_icon":false,"mime_type":"","file_size":0,"license":"","publisher":"","node_type":"collection","topic_pages":[],"guide_url":"","link":""},{"node_id":"47f15a3f-b7ed-41f7-9178-6dab79dd4227","title":"Welt ab 1945","description":"Hier findest du Materialien zur Geschichte nach 1945, zum Kalten Krieg und dazu, welche unterschiedlichen Entwicklungen die Sowjetunion und die USA nahmen.","disciplines":["Geschichte"],"educational_contexts":["Sekundarstufe I","Sekundarstufe II"],"user_roles":[],"keywords":["Stunde Null Deutschland","Nachkriegsjahre Zweiter Weltkrieg","Marshall-Plan, Währungsreform, Berlin-Blockade","Gründung der Bundesrepublik Deutschland","Gründung der Deutschen Demokratischen Republik","Doppelte Staatsgründung Deutschland","Kalter Krieg","Globalisierung","9/11","Terrorismus","Anschläge World Trade Center Folgen","Klimawandel","Entkolonialisierung","Blockbildung USA UdSSR",""],"learning_resource_types":[],"url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/47f15a3f-b7ed-41f7-9178-6dab79dd4227","wlo_url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/47f15a3f-b7ed-41f7-9178-6dab79dd4227","download_url":"","content_url":"","preview_url":"https://repository.staging.openeduhub.net/edu-sharing/preview?nodeId=47f15a3f-b7ed-41f7-9178-6dab79dd4227&storeProtocol=workspace&storeId=SpacesStore&dontcache=1778832915991","preview_is_icon":false,"mime_type":"","file_size":0,"license":"","publisher":"","node_type":"collection","topic_pages":[],"guide_url":"","link":""},{"node_id":"b2b83f95-cde1-4eeb-8adf-2ef3e219b06b","title":"21. Jahrhundert","description":"Einen Epochenumbruch stellte sicherlich das Ende des Kalten Krieges in den 90-er Jahren des 20. Jahrhundert dar. Und ab da soll hier das 21. Jahrhundert beginnen. - \nZu Beginn des kalendarischen 21. Jahrhunderts ist der internationale Terrorismus ein beherrschendes Thema. Dann wird immer deutlicher, dass sich die internationalen Kräfteverhältnisse verändern: China nimmt einer bedeutendere Rolle ein. Und der Klimawandel, das Ende fossiler Brennstoffe und eine Pandemie bewegen die Welt.","disciplines":["Geschichte"],"educational_contexts":["Elementarbereich","Sekundarstufe II","Hochschule","Primarstufe","Sekundarstufe I","Berufliche Bildung","Fortbildung","Erwachsenenbildung","Fernunterricht","Förderschule"],"user_roles":[],"keywords":["21. Jahrhundert","21. Jahrhundert Klimawandel","21. Jahrhundert Pandemie","21. Jahrhundert Terrorismus","21. Jahrhundert Globalisierung","21. Jahrhundert Gesellschaft","21. Jahrhundert Umwelt","Klimawandel","Corona Pandemie"],"learning_resource_types":[],"url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/b2b83f95-cde1-4eeb-8adf-2ef3e219b06b","wlo_url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/b2b83f95-cde1-4eeb-8adf-2ef3e219b06b","download_url":"","content_url":"","preview_url":"https://repository.staging.openeduhub.net/edu-sharing/preview?nodeId=b2b83f95-cde1-4eeb-8adf-2ef3e219b06b&storeProtocol=workspace&storeId=SpacesStore&dontcache=1778832916019","preview_is_icon":false,"mime_type":"","file_size":0,"license":"","publisher":"","node_type":"collection","topic_pages":[],"guide_url":"","link":""}],"query":"Klimawandel"}},"pagination":{"total_count":10,"skip_count":0,"page_size":5,"has_more":true,"collection_id":"","collection_title":""}}