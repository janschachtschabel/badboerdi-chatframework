s/render/ac18e9bf-3209-4606-a598-e8e290c9b999","wlo_url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/ac18e9bf-3209-4606-a598-e8e290c9b999","download_url":"","content_url":"","preview_url":"https://repository.staging.openeduhub.net/edu-sharing/preview?nodeId=ac18e9bf-3209-4606-a598-e8e290c9b999&storeProtocol=workspace&storeId=SpacesStore&dontcache=1778794000302","preview_is_icon":false,"mime_type":"","file_size":0,"license":"","publisher":"","node_type":"collection","topic_pages":[],"guide_url":"","link":""},{"node_id":"39f845f1-65d5-4f46-ba51-918133501101","title":"Ungleichungen","description":"Hier geht es um verschiedene Arten von Ungleichungen, zugehörigen Lösungsverfahren und Anwendungen in realen Problemstellungen.","disciplines":["Mathematik"],"educational_contexts":["Sekundarstufe II","Sekundarstufe I"],"user_roles":[],"keywords":["Ungleichung","Bruchrechnung"],"learning_resource_types":[],"url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/39f845f1-65d5-4f46-ba51-918133501101","wlo_url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/39f845f1-65d5-4f46-ba51-918133501101","download_url":"","content_url":"","preview_url":"https://repository.staging.openeduhub.net/edu-sharing/preview?nodeId=39f845f1-65d5-4f46-ba51-918133501101&storeProtocol=workspace&storeId=SpacesStore&dontcache=1778794000336","preview_is_icon":false,"mime_type":"","file_size":0,"license":"","publisher":"","node_type":"collection","topic_pages":[],"guide_url":"","link":""},{"node_id":"bc3958a8-9398-49e3-a790-be05e298c312","title":"Mathematik","description":"Viele physikalische Phänomene lassen sich auch ohne Mathematik verstehen und erklären. Allerdings stößt das intuitive Erfassen von Physik schnell an seine Grenzen und mathematische Formalismen werden notwendig, um physikalische Sachverhalte sinnvoll beschreiben zu können. Es gibt eine ganze Reihe mathematischer Fertigkeiten, wie die Auswertung von Messwerten, der Umgang mit Gleichungen und Größen oder die Nutzung der Differential- und Integralrechnung, die zu einem Verständnis der Physik notwendig sind.","disciplines":["Physik"],"educational_contexts":["Sekundarstufe I","Sekundarstufe II"],"user_roles":[],"keywords":["Formeln","Rechnen","Integralrechnung","Bruchrechnung","Termumformung","Potenzschreibweise","Umformen","Umstellen"],"learning_resource_types":[],"url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/bc3958a8-9398-49e3-a790-be05e298c312","wlo_url":"https://repository.staging.openeduhub.net/edu-sharing/components/render/bc3958a8-9398-49e3-a790-be05e298c312","download_url":"","content_url":"","preview_url":"https://repository.staging.openeduhub.net/edu-sharing/preview?nodeId=bc3958a8-9398-49e3-a790-be05e298c312&storeProtocol=workspace&storeId=SpacesStore&dontcache=1778794000366","preview_is_icon":false,"mime_type":"","file_size":0,"license":"","publisher":"","node_type":"collection","topic_pages":[],"guide_url":"","link":""}],"query":"Bruchrechnung"}},"pagination":{"total_count":9,"skip_count":0,"page_size":5,"has_more":true,"collection_id":"","collection_title":""}}