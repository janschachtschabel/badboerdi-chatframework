# BadBoerdi Backend — Local Environment Overrides
#
# Diese Datei wird beim Backend-Start von ``app.main:load_dotenv()``
# eingelesen. ``load_dotenv()`` überschreibt bestehende OS-Environment-
# Variablen NICHT — wer schon ``OPENAI_API_KEY`` etc. via Shell oder
# Process-Manager setzt, kann diese Datei trotzdem für Feature-Toggles
# nutzen.
#
# Vollständige Doku der unterstützten Variablen siehe .env.example.

# ── Feature-Toggles (testweise) ──────────────────────────────────

# Inline Quick Replies — Hauptantwort + Quick-Replies in EINEM LLM-Call
# liefern (via respond_to_user-Tool im Tool-Loop). Spart pro Turn
# ~1-2s, weil der separate generate_quick_replies-LLM-Call entfällt.
# Rollback: Zeile auf 0 setzen oder auskommentieren und Backend neu
# starten.
CHAT_INLINE_QUICK_REPLIES=1

# Falls die neue cache-friendly Reihenfolge des Klassifikator-System-
# Prompts (statisch zuerst, dynamisch zuletzt) je ein Problem macht,
# folgende Zeile auskommentieren um auf die alte Reihenfolge zurück
# zu rollen:
# CLASSIFY_PROMPT_LEGACY_ORDER=1

# ── Welle E v4+13 (2026-05-27): B-API Staging als Default-Anbindung ──
# Wir testen die erweiterte B-API. Default-Provider = B-API → OpenAI,
# Default-Modell gpt-5.4-nano (B-API leitet GPT-5 inkl. verbosity/
# reasoning_effort auf /chat/completions durch — getestet).
#
# WICHTIG — Key: Die App liest zentral ``B_API_KEY``. Diese .env-Datei
# kann ihn NICHT überschreiben, wenn ``B_API_KEY`` bereits als OS-Env-
# Variable gesetzt ist (load_dotenv überschreibt OS-Vars nicht). Für die
# Staging-Anbindung MUSS ``B_API_KEY`` den STAGING-Key enthalten
# (aktuell liegt der Staging-Key separat in ``B_API_KEY_STAGING``).
#   PowerShell (User-Scope dauerhaft):
#     [Environment]::SetEnvironmentVariable('B_API_KEY',
#        [Environment]::GetEnvironmentVariable('B_API_KEY_STAGING','User'), 'User')
#   oder pro Backend-Start:  $env:B_API_KEY = $env:B_API_KEY_STAGING
LLM_PROVIDER=b-api-openai
B_API_BASE_URL=https://b-api.staging.openeduhub.net/api/v1/llm
LLM_CHAT_MODEL=gpt-5.4-nano
# OpenAI-Standard-Embedding (1536 dim, DB-kompatibel) — läuft über die B-API
# (b-api-openai routet Embeddings durch den /openai-Passthrough, nicht nativ).
LLM_EMBED_MODEL=text-embedding-3-small

# ── Welle E (2026-05-23): Staging-Backend-URLs ───────────────────
# MCP-Server: Staging-Instanz (Vercel) statt Production
MCP_SERVER_URL=https://wlo-mcp-server-staging.vercel.app/mcp

# Repository-Base-URL für Card-Links + Such-CTA. Auf Staging zwingen,
# damit Repo-Render-URLs (Lotsen-Modus) und Such-Filter-Links auf das
# Staging-Repo zeigen statt aus dem Production-Default-Fallback
# "redaktion.openeduhub.net".
REPO_BASE_URL=https://repository.staging.openeduhub.net

# ── Card-Auswahl: Cross-Encoder statt LLM-select_top_cards (2026-06-01) ──
CHAT_DISABLE_SELECT_TOP_CARDS=1
CARD_CE_GATE_COLLECTION=0.0
CARD_CE_GATE_CONTENT=-1.5
CARD_CE_TOP_N=3
